<VStack>
    <HStack>
        <Image source="{{ $assets->images->logo }}" width="32" height="32" />
        <Label text="Hello from RageKit" size="title" />
    </HStack>
    <Card title="Counter">
        <Label text="Clicked {{ times() }}" />
        <HStack>
            <Button text="Click me" onClick="increment" grow="true" />
            <Button text="Reset" variant="outline" onClick="reset" />
        </HStack>
    </Card>
    <Entry value="{{ $store->profile->name }}" />
    <Label text="{{ $store->profile->greeting() }}" />
</VStack>
